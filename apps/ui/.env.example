# Fincomp System Design Environment Variables Example
# Base REST API URL for the Spring Boot GRC engine
NEXT_PUBLIC_API_URL=http://localhost:8080/api

# Subdomínio próprio de login e MFA, separado desta app
NEXT_PUBLIC_AUTH_URL=https://auth.fincomp.pro

# System Design Display Name
NEXT_PUBLIC_APP_NAME=Fincomp
