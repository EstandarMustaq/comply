{
  "$schema": "https://mintlify.com/docs.json",
  "theme": "mint",
  "name": "Comply",
  "description": "Guides for customer, transaction, alert and reporting workflows in regulated finance.",
  "colors": {
    "primary": "#0B746B"
  },
  "api": {
    "playground": {
      "display": "simple"
    },
    "url": "full",
    "examples": {
      "languages": ["curl", "javascript", "python"],
      "defaults": "required"
    }
  },
  "navigation": {
    "tabs": [
      {
        "tab": "Guides",
        "groups": [
          {
            "group": "Get started",
            "pages": ["index", "guides/getting-started", "guides/organization-and-access"]
          },
          {
            "group": "Use Comply",
            "pages": [
              "guides/clients",
              "guides/importing-data",
              "guides/reviewing-alerts",
              "guides/reports"
            ]
          }
        ]
      },
      {
        "tab": "Integrations",
        "groups": [
          {
            "group": "Overview",
            "pages": ["integrations/index"]
          },
          {
            "group": "Planned integrations",
            "pages": ["integrations/google-drive", "integrations/google-workspace"]
          }
        ]
      },
      {
        "tab": "API reference",
        "groups": [
          {
            "group": "Overview",
            "pages": ["api/index"]
          },
          {
            "group": "Endpoints",
            "openapi": "/openapi.json"
          }
        ]
      }
    ]
  }
}
