# ==============================================================================
# Complyz worktree environment
# Copy to .env for local Docker Compose. Production deployments must replace
# every development secret and select the existing production volume names.
# ==============================================================================

# Compose: `pnpm compose:up` starts the application profile; production deploys
# enable the production profile. Postgres and Redis are included in both.
COMPLYZ_ENVIRONMENT=development
COMPLYZ_IMAGE_TAG=local
SPRING_PROFILES_ACTIVE=dev

# Public domains for the application and API.
DOMAIN=localhost
API_DOMAIN=api.trycomplyz.com

# Host bindings: database/cache and app ports default to loopback only.
DB_BIND_ADDRESS=127.0.0.1
API_BIND_ADDRESS=127.0.0.1
UI_BIND_ADDRESS=127.0.0.1

# --- PostgreSQL Database ---
POSTGRES_DB=complyz_db
POSTGRES_USER=complyz_app
POSTGRES_PASSWORD=complyz_dev_password
DB_PORT=5432
POSTGRES_VOLUME_NAME=complyz_postgres_data

# --- Redis Cache & Anti-Replay Store ---
REDIS_PORT=6379
REDIS_PASSWORD=redis_dev_password
REDIS_VOLUME_NAME=complyz_redis_data
COMPLYZ_IMPORT_VOLUME_NAME=complyz_complyz_imports
CADDY_DATA_VOLUME_NAME=complyz_caddy_data
CADDY_CONFIG_VOLUME_NAME=complyz_caddy_config

# --- Security & Cryptography ---
# 256-bit AES key for TOTP secret encryption at rest (Base64 encoded, 32 bytes)
# Generate with: pnpm run keys -- --write
MFA_AES_KEY=0123456789abcdef0123456789abcdef
MFA_ENCRYPTION_KEY=0123456789abcdef0123456789abcdef

# 512-bit / 256-bit secret for JWT signing (HMAC)
# Generate with: pnpm run keys -- --write
JWT_SECRET=404E635266556A586E3272357538782F413F4428472B4B6250645367566B5970
JWT_EXPIRATION_MINUTES=60

# --- Network & CORS ---
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# --- Initial user bootstrap (disabled by default) ---
# Enable only for a controlled first deployment, then disable and rotate passwords.
COMPLYZ_BOOTSTRAP_ENABLED=false
COMPLYZ_BOOTSTRAP_ADMIN_FULL_NAME=
COMPLYZ_BOOTSTRAP_ADMIN_EMAIL=
COMPLYZ_BOOTSTRAP_ADMIN_PASSWORD=
COMPLYZ_BOOTSTRAP_OCOS_FULL_NAME=
COMPLYZ_BOOTSTRAP_OCOS_EMAIL=
COMPLYZ_BOOTSTRAP_OCOS_PASSWORD=

# --- Web UI ---
NEXT_PUBLIC_API_URL=http://localhost:8080/api/v1
NEXT_PUBLIC_AUTH_URL=https://api.trycomplyz.com
NEXT_PUBLIC_APP_NAME=Complyz

# --- Encrypted PostgreSQL backup to S3 (pnpm backup) ---
# This job backs up PostgreSQL only; it does not back up Redis or imported files.
S3_BACKUP_BUCKET=complyz-backups-client-slug
AWS_REGION=af-south-1
BACKUP_ENCRYPTION_PASSPHRASE=generate_a_secure_passphrase_for_gpg_backup
BACKUP_OBJECT_LOCK_RETENTION_YEARS=10

# Production-only example values: preserve the existing named volumes during
# cutover by using these names in the deployment .env:
# COMPOSE_PROFILES=production
# COMPLYZ_ENVIRONMENT=production
# SPRING_PROFILES_ACTIVE=production
# POSTGRES_VOLUME_NAME=complyz_postgres_prod_data
# REDIS_VOLUME_NAME=complyz_redis_prod_data
# COMPLYZ_IMPORT_VOLUME_NAME=complyz_complyz_imports
# DOMAIN=trycomplyz.com
# API_DOMAIN=api.trycomplyz.com
# CORS_ALLOWED_ORIGINS=https://trycomplyz.com
# NEXT_PUBLIC_API_URL=https://api.trycomplyz.com/api/v1
# NEXT_PUBLIC_AUTH_URL=https://api.trycomplyz.com
