# ==============================================================================
# FinComp AML-CFT Platform - Environment Configuration Template
# Copy this file to .env for Docker/Compose or deployment
# ==============================================================================

# Domain for Caddy Reverse Proxy & TLS (Let's Encrypt in production)
DOMAIN=localhost

# Profile (dev | prod)
SPRING_PROFILES_ACTIVE=dev

# --- PostgreSQL Database ---
POSTGRES_DB=fincomp_db
POSTGRES_USER=fincomp_app
POSTGRES_PASSWORD=fincomp_dev_password
DB_HOST=localhost
DB_PORT=5432

# --- Redis Cache & Anti-Replay Store ---
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=redis_dev_password

# --- Security & Cryptography ---
# 256-bit AES key for TOTP secret encryption at rest (Base64 encoded, 32 bytes)
# Generate with: openssl rand -base64 32
MFA_AES_KEY=0123456789abcdef0123456789abcdef
MFA_ENCRYPTION_KEY=0123456789abcdef0123456789abcdef

# 512-bit / 256-bit secret for JWT signing (HMAC)
# Generate with: openssl rand -hex 64
JWT_SECRET=404E635266556A586E3272357538782F413F4428472B4B6250645367566B5970
JWT_EXPIRATION_MINUTES=60

# --- Network & CORS ---
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# --- Frontend Client ---
NEXT_PUBLIC_API_URL=http://localhost:8080/api
NEXT_PUBLIC_APP_NAME=FinComp

# --- Automated Backup (scripts/backup-s3.sh) ---
S3_BACKUP_BUCKET=fincomp-backups-client-slug
AWS_REGION=af-south-1
BACKUP_ENCRYPTION_PASSPHRASE=generate_a_secure_passphrase_for_gpg_backup
