# ==============================================================================
# Comply worktree environment
# Copy to .env for local Docker Compose. Production deployments must replace
# every development secret and select the existing production volume names.
# ==============================================================================

# Compose: `pnpm compose:up` starts the application profile. Production uses
# dedicated services and volumes in the production profile.
COMPLY_ENVIRONMENT=development
COMPLY_IMAGE_TAG=local
SPRING_PROFILES_ACTIVE=dev

# Public domains for the application and API.
DOMAIN=localhost
API_DOMAIN=api.trycomply.io

# Host bindings: database/cache and app ports default to loopback only.
DB_BIND_ADDRESS=127.0.0.1
API_BIND_ADDRESS=127.0.0.1
UI_BIND_ADDRESS=127.0.0.1

# --- PostgreSQL Database ---
POSTGRES_DB=comply_db
POSTGRES_USER=comply_app
POSTGRES_PASSWORD=comply_dev_password
DB_PORT=5432

# --- Redis Cache & Anti-Replay Store ---
REDIS_PORT=6379
REDIS_PASSWORD=redis_dev_password
COMPLY_IMPORT_VOLUME_NAME=comply_imports
CADDY_DATA_VOLUME_NAME=comply_caddy_data
CADDY_CONFIG_VOLUME_NAME=comply_caddy_config

# --- Security & Cryptography ---
# 256-bit AES key for TOTP secret encryption at rest (Base64 encoded, 32 bytes)
# Generate with: pnpm run keys -- --write
MFA_AES_KEY=0123456789abcdef0123456789abcdef
MFA_ENCRYPTION_KEY=0123456789abcdef0123456789abcdef

# 512-bit / 256-bit secret for JWT signing (HMAC)
# Generate with: pnpm run keys -- --write
JWT_SECRET=404E635266556A586E3272357538782F413F4428472B4B6250645367566B5970
JWT_EXPIRATION_MINUTES=60

# --- Network & CORS ---
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# --- Initial user bootstrap (disabled by default) ---
# Enable only for a controlled first deployment, then disable and rotate passwords.
COMPLY_BOOTSTRAP_ENABLED=false
COMPLY_BOOTSTRAP_ADMIN_FULL_NAME=
COMPLY_BOOTSTRAP_ADMIN_EMAIL=
COMPLY_BOOTSTRAP_ADMIN_PASSWORD=
COMPLY_BOOTSTRAP_OCOS_FULL_NAME=
COMPLY_BOOTSTRAP_OCOS_EMAIL=
COMPLY_BOOTSTRAP_OCOS_PASSWORD=

# --- Web UI ---
NEXT_PUBLIC_API_URL=http://localhost:8080/api/v1
NEXT_PUBLIC_AUTH_URL=https://api.trycomply.io
NEXT_PUBLIC_APP_NAME=Comply

# --- Encrypted PostgreSQL backup to S3 (pnpm backup) ---
# This job backs up PostgreSQL only; it does not back up Redis or imported files.
S3_BACKUP_BUCKET=comply-backups-client-slug
AWS_REGION=af-south-1
BACKUP_ENCRYPTION_PASSPHRASE=generate_a_secure_passphrase_for_gpg_backup
BACKUP_OBJECT_LOCK_RETENTION_YEARS=10

# Production-only example values: `pnpm deploy` or run
# `docker compose --profile production up -d --build` to activate production.
# Preserve the existing named volumes during cutover:
# COMPOSE_PROFILES=production
# COMPLY_ENVIRONMENT=production
# SPRING_PROFILES_ACTIVE=production
# POSTGRES_VOLUME_NAME=comply_postgres_prod_data
# REDIS_VOLUME_NAME=comply_redis_prod_data
# COMPLY_IMPORT_VOLUME_NAME=comply_imports
# DOMAIN=trycomply.io
# API_DOMAIN=api.trycomply.io
# CORS_ALLOWED_ORIGINS=https://trycomply.io
# NEXT_PUBLIC_API_URL=https://api.trycomply.io/api/v1
# NEXT_PUBLIC_AUTH_URL=https://api.trycomply.io
