{
  "name": "complyz",
  "private": true,
  "license": "AGPL-3.0-only",
  "packageManager": "pnpm@12.8.1",
  "engines": {
    "node": "26.5.0",
    "pnpm": "12.8.1"
  },
  "scripts": {
    "dev": "node scripts/workspace.mjs dev",
    "start": "pnpm --filter @complyz/web start",
    "dev:docker": "node scripts/compose.mjs up",
    "build": "node scripts/workspace.mjs build",
    "test": "node scripts/workspace.mjs test",
    "test:unit": "turbo run test:unit",
    "test:contract": "turbo run test:contract",
    "test:e2e": "turbo run test:e2e",
    "check": "turbo run check typecheck && prettier --check .",
    "typecheck": "turbo run typecheck",
    "lint": "turbo run lint",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "api:build": "node scripts/workspace.mjs api:build",
    "api:test": "node scripts/workspace.mjs api:test",
    "api:run": "node scripts/workspace.mjs api:run",
    "api:openapi": "node scripts/openapi.mjs",
    "operations:test": "node scripts/operations.test.mjs",
    "compose:config": "node scripts/compose.mjs config",
    "compose:up": "node scripts/compose.mjs up",
    "compose:down": "node scripts/compose.mjs down",
    "quality": "node scripts/workspace.mjs quality",
    "migrate": "node scripts/workspace.mjs migrate",
    "hooks:install": "node scripts/setup-git-hooks.mjs",
    "hooks:check": "node scripts/setup-git-hooks.mjs --check",
    "hooks:test": "node scripts/test-git-hooks.mjs",
    "deploy": "node scripts/workspace.mjs deploy",
    "backup": "node scripts/workspace.mjs backup",
    "keys": "node scripts/workspace.mjs keys",
    "clean": "node scripts/workspace.mjs clean"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.11.1",
    "@playwright/test": "1.63.0",
    "eslint": "^9.39.5",
    "jsdom": "^28.1.0",
    "openapi-typescript": "^7.10.1",
    "prettier": "3.9.7",
    "prettier-plugin-tailwindcss": "^0.6.14",
    "turbo": "^2.6.3",
    "typescript": "^5.9.3",
    "vitest": "^5.0.1"
  }
}
