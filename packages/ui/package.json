{
  "name": "@comply/ui",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Shared UI test utilities and test suites for Comply",
  "license": "AGPL-3.0-only",
  "exports": {
    ".": "./src/index.ts",
    "./utils": "./src/utils.ts"
  },
  "dependencies": {
    "clsx": "^2.1.1",
    "tailwind-merge": "^3.7.0"
  },
  "scripts": {
    "test": "pnpm run test:unit",
    "test:unit": "vitest run --config ../../apps/ui/vitest.config.mts --project unit",
    "test:contract": "vitest run --config ../../apps/ui/vitest.config.mts --project contract",
    "test:watch": "vitest --config ../../apps/ui/vitest.config.mts --project unit"
  }
}
