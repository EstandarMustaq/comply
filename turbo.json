{
  "$schema": "https://turbo.build/schema.json",
  "ui": "tui",
  "globalDependencies": [".prettierrc.json", "pnpm-lock.yaml", "pnpm-workspace.yaml"],
  "globalEnv": ["NEXT_PUBLIC_API_URL", "NEXT_PUBLIC_APP_NAME", "COMPLY_OPENAPI_URL"],
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": [".next/**", "!.next/cache/**", "dist/**"]
    },
    "dev": {
      "cache": false,
      "persistent": true
    },
    "test": {
      "dependsOn": ["^build"],
      "outputs": ["coverage/**", "test-results/**"]
    },
    "test:unit": {
      "cache": true
    },
    "test:contract": {
      "dependsOn": ["^build"]
    },
    "storybook:build": {
      "outputs": ["storybook-static/**"]
    },
    "typecheck": {},
    "lint": {},
    "check": {
      "dependsOn": ["typecheck", "lint"]
    },
    "clean": {
      "cache": false
    }
  }
}
